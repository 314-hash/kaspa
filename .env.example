# ExJanAI Blockchain Configuration
# Copy this file to .env and fill in your values

# Kaspa L1 Operator Address (starts with "kaspa:q..." for Mainnet or "kaspatest:q..." for Testnet)
KASPA_OPERATOR_ADDRESS=kaspa:your_kaspa_address_here

# Kaspa RPC / REST Endpoint (Default: official public REST server)
KASPA_RPC_URL=https://api.kaspa.org

# Virtual Selected Parent BlueScore confirmation depth required for finality
KASPA_CONFIRMATION_DEPTH=120

# ExJanAI Layer 2 Configuration
EXJANAI_CHAIN_ID=1111
PORT=3000
